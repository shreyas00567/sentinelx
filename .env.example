# ============================================================
# SentinelX environment configuration (copy to .env and edit)
# Never commit the real .env file.
# ============================================================

# --- Database ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=sentinelx
DB_USER=sentinelx
DB_PASSWORD=sentinelx

# --- Security ---
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
JWT_EXPIRATION_MINUTES=120

# Seeded demo accounts (change in production!)
SEED_ADMIN_USER=admin
SEED_ADMIN_PASS=Admin@123
SEED_ANALYST_PASS=Analyst@123

# --- ML service ---
ML_BASE_URL=http://localhost:8000

# --- Risk engine ---
RISK_INCIDENT_THRESHOLD=55

# --- Threat intelligence (optional; leave empty for offline heuristic mode) ---
ABUSEIPDB_API_KEY=

# --- Frontend dev proxy target ---
VITE_API_URL=http://localhost:8080
